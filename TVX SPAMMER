-- Chat Send Function
local function sendRawChatMessage(message)
    local success = pcall(function()
        local textChannels = TextChatService:FindFirstChild("TextChannels")
        local general = textChannels and textChannels:FindFirstChild("RBXGeneral")
        if general then
            general:SendAsync(message)
            return true
        end
    end)
    if success then return end

    pcall(function()
        local events = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if events and events:FindFirstChild("SayMessageRequest") then
            events.SayMessageRequest:FireServer(message, "All")
        end
    end)
end

