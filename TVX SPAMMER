-- Logic Connections
local function sendChatMessage(msg, target)
    local repeatedPrefix = string.rep(selectedPrefix, 10)
    local finalMessage = repeatedPrefix .. " "
    if target and target:gsub("%s+", "") ~= "" then
        finalMessage = finalMessage .. "[" .. target .. "] "
    end
    finalMessage = finalMessage .. msg .. " " .. repeatedPrefix
    sendRawChatMessage(finalMessage)
end

